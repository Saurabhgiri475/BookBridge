# Copy this file to .env and fill in your own values.
# .env is already in .gitignore - never commit real secrets.

# --- Core Django settings ---
# Local dev: keep DEBUG=True below (settings.py then falls back to a fixed dev-only key).
# DEBUG defaults to OFF when unset, so a server that forgets it is safe. Production needs a real
# SECRET_KEY, DEBUG=False, ALLOWED_HOSTS and a shared cache (REDIS_URL). Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=True
# Show OTPs on screen when SMS isn't configured. Local demos only - the app refuses to start with DEBUG=False and DEMO_MODE=True.
DEMO_MODE=True
# Where sensitive uploads (partner ID/shop proofs, paid digital files) are stored. Never expose this folder via a web server.
PRIVATE_MEDIA_ROOT=
# Two-factor authentication for staff/admin (keep True in production). Session validity in seconds.
STAFF_2FA_REQUIRED=True
STAFF_2FA_MAX_AGE_SECONDS=43200
# Content-Security-Policy: defaults to enforce when DEBUG is off (report-only in local dev); or set off.
# CSP_MODE=enforce
# Shared cache for rate limiting - REQUIRED in production (or CACHE_BACKEND=db).
REDIS_URL=
# Comma-separated. Required once DEBUG=False (see bookmarket/settings.py).
ALLOWED_HOSTS=

# --- Database ---
# Leave blank to use SQLite (db.sqlite3), zero setup required. For Postgres,
# set DATABASE_URL as postgres://user:password@host:port/dbname - most
# managed Postgres providers give you this directly. Recommended beyond solo local dev:
# wallet/services.py relies on row-level locking (select_for_update) that
# SQLite doesn't enforce the way Postgres does.
DATABASE_URL=

# --- Razorpay (https://dashboard.razorpay.com/app/keys) - Test Mode keys first ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set after creating the webhook in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=

# --- Cover scanning OCR (optional, free) - tried in this order: ---
# OCR.space -> Gemini -> Google Vision (if set) -> offline Tesseract.
# Any blank key is skipped; a failing engine just falls through to the next.
# OCR.space free key (request by email, no card): https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=
# Gemini free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google Cloud Vision (optional) ---
# Upgrades the "Scan Book Cover" OCR from offline Tesseract to Google's more
# accurate cover-photo text reading. https://console.cloud.google.com/apis/credentials
# -> enable "Cloud Vision API" on your project first, then create an API key
# (restrict it to Vision). Leave blank to keep using the free offline OCR.
GOOGLE_VISION_API_KEY=

# --- Groq API (optional, free) ---
# Upgrades "AI Search" from the offline regex parser (books/nlp_search.py) to
# a real LLM call (books/llm_search.py) - handles phrasing/universities/
# branches the regex parser was never taught. Get a free key (no credit card)
# from https://console.groq.com/keys. Leave blank to keep using the free
# offline parser; it's also the automatic fallback if a call ever fails.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Shiprocket (https://app.shiprocket.in) - your dashboard login ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Must match a Pickup Location nickname under Shiprocket > Settings > Pickup Locations
SHIPROCKET_PICKUP_LOCATION=Primary
# Shared secret you choose and set in Shiprocket > Settings > API > Webhooks
SHIPROCKET_WEBHOOK_TOKEN=

# --- Email ---
# Leave EMAIL_BACKEND unset to just print emails to the console.
# For real delivery, e.g. Gmail SMTP (use an App Password, not your login password):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BookBridge <no-reply@yourdomain.com>
# Contact details shown in the footer, /contact/, the login + password-reset pages and security emails.
SUPPORT_PHONE=7985486802
SUPPORT_EMAIL=saurabhgiri95893@gmail.com
# Password-reset link lifetime in seconds (default 3600 = 1 hour).
PASSWORD_RESET_TIMEOUT=3600

# --- Twilio (https://console.twilio.com) - SMS + WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Default below is Twilio's free WhatsApp sandbox number - fine for dev/testing
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Web Push (browser push notifications) ---
# Generate a keypair once with: pip install py-vapid && vapid --gen
# (writes private_key.pem/public_key.pem in the current directory - open
# them and paste the raw base64url values below), or use a quick online
# generator like https://vapidkeys.com for local dev. Leave blank to keep
# push notifications disabled - every other channel still works.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIMS_EMAIL=admin@yourdomain.com

# --- Donation certificates ---
# Optional .ttf for the PDF certificate (needed only to print names in non-Latin scripts,
# e.g. Noto Sans Devanagari). Leave blank to use built-in Helvetica.
CERTIFICATE_FONT_PATH=

# Hours payouts are blocked after a seller changes their UPI ID (default 72)
# PAYOUT_UPI_HOLD_HOURS=72

# Minutes a listing is held for a buyer on the online-payment page (default 20)
# PAYMENT_HOLD_MINUTES=20
# Only for a deliberate single-worker deployment without Redis/DB cache:
# ALLOW_LOCMEM_CACHE=False
